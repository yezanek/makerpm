Name:           myservice
Version:        1.0.0
Release:        1%{?dist}
Summary:        A service with custom scriptlets
License:        MIT
Source0:       https://example.org/myservice-1.0.0.tar.gz
Source0_sha256: dd1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef


%description
myservice is a system service with custom pre/post installation scripts.

%prep
%autosetup


%build

%make_build


%install

%make_install



%files

%dir %{_sysconfdir}/myservice/

%{_bindir}/myservice

%config(noreplace) %{_sysconfdir}/myservice/config.toml

%pre -p /bin/sh
/usr/sbin/useradd -r -s /sbin/nologin myservice 2>/dev/null || :

%post -p /bin/sh
/usr/bin/systemctl daemon-reload

%postun -p /bin/sh
/usr/bin/systemctl daemon-reload

