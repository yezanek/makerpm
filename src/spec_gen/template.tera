{#- RPM spec file generated by makerpm -#}
Name:           {{ name }}
Version:        {{ version }}
Release:        {{ release }}
{%- if epoch is number %}
Epoch:          {{ epoch }}
{%- endif %}
Summary:        {{ summary | rpm_escape }}
License:        {{ license }}
{%- if url %}
URL:            {{ url }}
{%- endif %}
{%- if group %}
Group:          {{ group }}
{%- endif %}
{%- for src in sources %}
Source{{ loop.index0 }}:       {{ src }}
{%- endfor %}
{%- for patch in patches %}
Patch{{ loop.index0 }}:       {{ patch }}
{%- endfor %}
{%- for dep in build_requires %}
BuildRequires:  {{ dep }}
{%- endfor %}
{%- for dep in requires %}
Requires:       {{ dep }}
{%- endfor %}
{%- for dep in recommends %}
Recommends:     {{ dep }}
{%- endfor %}
{%- for dep in suggests %}
Suggests:       {{ dep }}
{%- endfor %}
{%- for dep in supplements %}
Supplements:    {{ dep }}
{%- endfor %}
{%- for dep in enhances %}
Enhances:       {{ dep }}
{%- endfor %}
{%- for dep in conflicts %}
Conflicts:      {{ dep }}
{%- endfor %}
{%- for dep in provides %}
Provides:       {{ dep }}
{%- endfor %}
{%- for dep in obsoletes %}
Obsoletes:      {{ dep }}
{%- endfor %}
{% if noarch %}
BuildArch:      noarch
{% endif %}

%description
{{ description | rpm_escape }}
{%- for pkg in renderables %}
{%- if not pkg.is_base %}

%package        {{ pkg.suffix }}
Summary:        {{ pkg.summary | rpm_escape }}
{%- if pkg.noarch %}
BuildArch:      noarch
{%- endif %}
{%- if pkg.license %}
License:        {{ pkg.license }}
{%- endif %}
{%- if pkg.url %}
URL:            {{ pkg.url }}
{%- endif %}
{%- for dep in pkg.depends %}
Requires:       {{ dep }}
{%- endfor %}
{%- for dep in pkg.recommends %}
Recommends:     {{ dep }}
{%- endfor %}
{%- for dep in pkg.suggests %}
Suggests:       {{ dep }}
{%- endfor %}
{%- for dep in pkg.supplements %}
Supplements:    {{ dep }}
{%- endfor %}
{%- for dep in pkg.enhances %}
Enhances:       {{ dep }}
{%- endfor %}
{%- for dep in pkg.conflicts %}
Conflicts:      {{ dep }}
{%- endfor %}
{%- for dep in pkg.provides %}
Provides:       {{ dep }}
{%- endfor %}
{%- for dep in pkg.obsoletes %}
Obsoletes:      {{ dep }}
{%- endfor %}

%description    {{ pkg.suffix }}
{{ pkg.description | rpm_escape }}
{%- endif %}
{%- endfor %}

%prep
{% if use_default_setup %}
%autosetup -p1{% if disable_automatic_patches %} -N{% endif %}
{% endif %}
{% if prep_steps %}
{{ prep_steps }}
{% endif %}

%build
{% if build_section %}
{{ build_section }}
{% endif %}

%install
{% if install_section %}
{{ install_section }}
{% endif %}
{% if include_check %}

%check
{{ check_section }}
{% endif %}

%files
{%- for pkg in renderables %}
{%- if pkg.is_base %}
{%- for path in pkg.dirs %}

%dir {{ path }}
{%- endfor %}
{%- for path in pkg.paths %}

{{ path }}
{%- endfor %}
{%- for path in pkg.docs %}

%doc {{ path }}
{%- endfor %}
{%- for path in pkg.licenses %}

%license {{ path }}
{%- endfor %}
{%- for path in pkg.configs_noreplace %}

%config(noreplace) {{ path }}
{%- endfor %}
{%- for path in pkg.configs %}

%config {{ path }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- for pkg in renderables %}
{%- if not pkg.is_base %}

%files          {{ pkg.suffix }}
{%- for path in pkg.dirs %}

%dir {{ path }}
{%- endfor %}
{%- for path in pkg.paths %}

{{ path }}
{%- endfor %}
{%- for path in pkg.docs %}

%doc {{ path }}
{%- endfor %}
{%- for path in pkg.licenses %}

%license {{ path }}
{%- endfor %}
{%- for path in pkg.configs_noreplace %}

%config(noreplace) {{ path }}
{%- endfor %}
{%- for path in pkg.configs %}

%config {{ path }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- for pkg in renderables %}
{%- if pkg.pretrans is string %}
{%- if pkg.interpreter is string and pkg.is_base %}

%pretrans -p {{ pkg.interpreter }}
{{ pkg.pretrans }}
{%- elif pkg.interpreter is string %}

%pretrans -n {{ pkg.name }} -p {{ pkg.interpreter }}
{{ pkg.pretrans }}
{%- elif pkg.is_base %}

%pretrans
{{ pkg.pretrans }}
{%- else %}

%pretrans -n {{ pkg.name }}
{{ pkg.pretrans }}
{%- endif %}
{%- endif %}
{%- if pkg.pre is string %}
{%- if pkg.interpreter is string and pkg.is_base %}

%pre -p {{ pkg.interpreter }}
{{ pkg.pre }}
{%- elif pkg.interpreter is string %}

%pre -n {{ pkg.name }} -p {{ pkg.interpreter }}
{{ pkg.pre }}
{%- elif pkg.is_base %}

%pre
{{ pkg.pre }}
{%- else %}

%pre -n {{ pkg.name }}
{{ pkg.pre }}
{%- endif %}
{%- endif %}
{%- if pkg.post is string %}
{%- if pkg.interpreter is string and pkg.is_base %}

%post -p {{ pkg.interpreter }}
{{ pkg.post }}
{%- elif pkg.interpreter is string %}

%post -n {{ pkg.name }} -p {{ pkg.interpreter }}
{{ pkg.post }}
{%- elif pkg.is_base %}

%post
{{ pkg.post }}
{%- else %}

%post -n {{ pkg.name }}
{{ pkg.post }}
{%- endif %}
{%- endif %}
{%- if pkg.preun is string %}
{%- if pkg.interpreter is string and pkg.is_base %}

%preun -p {{ pkg.interpreter }}
{{ pkg.preun }}
{%- elif pkg.interpreter is string %}

%preun -n {{ pkg.name }} -p {{ pkg.interpreter }}
{{ pkg.preun }}
{%- elif pkg.is_base %}

%preun
{{ pkg.preun }}
{%- else %}

%preun -n {{ pkg.name }}
{{ pkg.preun }}
{%- endif %}
{%- endif %}
{%- if pkg.postun is string %}
{%- if pkg.interpreter is string and pkg.is_base %}

%postun -p {{ pkg.interpreter }}
{{ pkg.postun }}
{%- elif pkg.interpreter is string %}

%postun -n {{ pkg.name }} -p {{ pkg.interpreter }}
{{ pkg.postun }}
{%- elif pkg.is_base %}

%postun
{{ pkg.postun }}
{%- else %}

%postun -n {{ pkg.name }}
{{ pkg.postun }}
{%- endif %}
{%- endif %}
{%- if pkg.posttrans is string %}
{%- if pkg.interpreter is string and pkg.is_base %}

%posttrans -p {{ pkg.interpreter }}
{{ pkg.posttrans }}
{%- elif pkg.interpreter is string %}

%posttrans -n {{ pkg.name }} -p {{ pkg.interpreter }}
{{ pkg.posttrans }}
{%- elif pkg.is_base %}

%posttrans
{{ pkg.posttrans }}
{%- else %}

%posttrans -n {{ pkg.name }}
{{ pkg.posttrans }}
{%- endif %}
{%- endif %}
{%- endfor %}

%changelog
{%- for entry in changelog %}

* {{ entry.date | rpm_date }} {{ entry.packager }} - {{ entry.version }}
{%- for line in entry.entries %}

- {{ line | rpm_escape }}
{%- endfor %}
{%- endfor %}
